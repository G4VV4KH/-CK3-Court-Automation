# Saved native policy bridge. Always loaded; no panel visibility dependency.
# Native getters acknowledge each type; no failed command is retried per frame.
# Job targets freeze per owner/epoch. After Off restore, manual vanilla changes
# are tracked back into saved lists, so succession preserves mixed settings.
# Excluded roles are ignored except for a one-time release of their saved policy.
window = {
	name = ca_native_automation_controller
	size = { 1 1 }
	alwaystransparent = yes
	visible = "[GetPlayer.IsValid]"
	oncreate = "[GetVariableSystem.Clear('ca_native_session')]"
	oncreate = "[GetVariableSystem.Clear('ca_native_session_ready')]"
	oncreate = "[GetVariableSystem.Clear('ca_native_begin_busy')]"
	oncreate = "[GetVariableSystem.Clear('ca_native_begin_attempt_session')]"
	oncreate = "[GetVariableSystem.Clear('ca_native_begin_attempt_count')]"
	state = {
		name = _show
		alpha = 1
		on_start = "[GetVariableSystem.Clear('ca_native_session')]"
		on_start = "[GetVariableSystem.Clear('ca_native_session_ready')]"
		on_start = "[GetVariableSystem.Clear('ca_native_begin_busy')]"
		on_start = "[GetVariableSystem.Clear('ca_native_begin_attempt_session')]"
		on_start = "[GetVariableSystem.Clear('ca_native_begin_attempt_count')]"
	}
	state = { name = ca_native_noop alpha = 1 }
	state = {
		name = ca_native_begin
		alpha = 1
		trigger_when = "[And( Not( GetVariableSystem.Exists('ca_native_begin_busy') ), And( And( And( And( GetPlayer.IsValid, GetPlayer.IsAlive ), And( GetPlayer.IsLocalPlayer, GetPlayer.IsPlayer ) ), GetScriptedGui('ca_native_player_available').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), And( Or( Not( GetVariableSystem.HasValue('ca_native_begin_attempt_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))) ), Not( GetVariableSystem.HasValue('ca_native_begin_attempt_count', '4') ) ), Or( Not( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))) ), And( Not( GetVariableSystem.Exists('ca_native_session_ready') ), GetVariableSystem.HasValue('ca_native_begin_before', IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_bridge_generation').GetValue))) ) ) ) ) )]"
		on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( Not( GetVariableSystem.Exists('ca_native_begin_busy') ), And( And( And( And( GetPlayer.IsValid, GetPlayer.IsAlive ), And( GetPlayer.IsLocalPlayer, GetPlayer.IsPlayer ) ), GetScriptedGui('ca_native_player_available').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), And( Or( Not( GetVariableSystem.HasValue('ca_native_begin_attempt_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))) ), Not( GetVariableSystem.HasValue('ca_native_begin_attempt_count', '4') ) ), Or( Not( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))) ), And( Not( GetVariableSystem.Exists('ca_native_session_ready') ), GetVariableSystem.HasValue('ca_native_begin_before', IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_bridge_generation').GetValue))) ) ) ) ) ), 'ca_native_begin_action', 'ca_native_noop'))]"
	}
	state = {
		name = ca_native_begin_action
		alpha = 1
		# Four dispatches at most per actual owner/epoch/mode, 0.5 seconds apart.
		# Retry only the unacknowledged script begin, never the native type commands.
		# A failed final attempt leaves the safe pending barrier and Off escape intact.
		on_start = "[GetVariableSystem.Set('ca_native_begin_busy', 'yes')]"
		on_start = "[PdxGuiTriggerAllAnimations('ca_native_begin_cooldown')]"
		on_start = "[GetVariableSystem.Set('ca_native_begin_attempt_count', Select_CString(GetVariableSystem.HasValue('ca_native_begin_attempt_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), Select_CString(GetVariableSystem.HasValue('ca_native_begin_attempt_count', '1'), '2', Select_CString(GetVariableSystem.HasValue('ca_native_begin_attempt_count', '2'), '3', '4')), '1'))]"
		on_start = "[GetVariableSystem.Set('ca_native_begin_attempt_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off'))))))]"
		on_start = "[GetVariableSystem.Clear('ca_native_session_ready')]"
		on_start = "[GetVariableSystem.Set('ca_native_begin_before', IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_bridge_generation').GetValue)))]"
		on_start = "[GetVariableSystem.Set('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off'))))))]"
		on_start = "[GetScriptedGui('ca_native_policy_begin').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}
	state = {
		name = ca_native_begin_ack
		alpha = 1
		trigger_when = "[And( And( GetPlayer.IsValid, GetScriptedGui('ca_native_player_available').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), And( Not( GetVariableSystem.Exists('ca_native_session_ready') ), Not( GetVariableSystem.HasValue('ca_native_begin_before', IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_bridge_generation').GetValue))) ) ) ) )]"
		on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( And( GetPlayer.IsValid, GetScriptedGui('ca_native_player_available').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), And( Not( GetVariableSystem.Exists('ca_native_session_ready') ), Not( GetVariableSystem.HasValue('ca_native_begin_before', IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_bridge_generation').GetValue))) ) ) ) ), 'ca_native_begin_ack_action', 'ca_native_noop'))]"
	}
	state = {
		name = ca_native_begin_ack_action
		alpha = 1
		on_start = "[GetVariableSystem.Set('ca_native_job_token', Concatenate(GetVariableSystem.Get('ca_native_session'), Concatenate('_', IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_bridge_generation').GetValue)))))]"
		on_start = "[GetVariableSystem.Set('ca_native_session_ready', 'yes')]"
	}
	state = {
		name = ca_native_ready
		alpha = 1
		trigger_when = "[And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, And( Not( GetPlayer.MakeScope.GetVariable('ca_native_policy_ready').IsSet ), And( GetScriptedGui('ca_native_policy_ready').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), EqualTo_int32(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_off_count').GetValue), FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_type_count').GetValue)) ) ) ) )]"
		on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, And( Not( GetPlayer.MakeScope.GetVariable('ca_native_policy_ready').IsSet ), And( GetScriptedGui('ca_native_policy_ready').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), EqualTo_int32(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_off_count').GetValue), FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_type_count').GetValue)) ) ) ) ), 'ca_native_ready_action', 'ca_native_noop'))]"
	}
	state = {
		name = ca_native_ready_action
		alpha = 1
		on_start = "[GetScriptedGui('ca_native_policy_ready').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}
	state = {
		name = ca_native_restore_ready
		alpha = 1
		trigger_when = "[And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( Not( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet ), And( GetPlayer.MakeScope.GetVariable('ca_native_restore_pending').IsSet, And( GetScriptedGui('ca_native_policy_restored').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), EqualTo_int32(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_applied_count').GetValue), FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_apply_type_count').GetValue)) ) ) ) )]"
		on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( Not( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet ), And( GetPlayer.MakeScope.GetVariable('ca_native_restore_pending').IsSet, And( GetScriptedGui('ca_native_policy_restored').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ), EqualTo_int32(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_applied_count').GetValue), FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_apply_type_count').GetValue)) ) ) ) ), 'ca_native_restore_ready_action', 'ca_native_noop'))]"
	}
	state = {
		name = ca_native_restore_ready_action
		alpha = 1
		on_start = "[GetScriptedGui('ca_native_policy_restored').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
	}
	# Explicitly started per begin dispatch; this is not a permanent polling loop.
	# A separate widget keeps ACK transitions from cancelling the re-arm timer.
	widget = {
		name = ca_native_begin_rearm
		size = { 1 1 }
		alwaystransparent = yes
		state = {
			name = ca_native_begin_cooldown
			duration = 0.5
			alpha = 1
			on_finish = "[GetVariableSystem.Clear('ca_native_begin_busy')]"
			# Explicit revalidation also covers long frames that span the cooldown.
			on_finish = "[PdxGuiTriggerAllAnimations('ca_native_begin')]"
		}
	}
	# Let the native knight maximum settle after actual local player transfer.
	# This independent one-shot captures its owner; a changed or cancelled owner is a noop.
	widget = {
		name = ca_native_initial_knights
		size = { 1 1 }
		alwaystransparent = yes
		state = { name = ca_native_knights_noop alpha = 1 }
		state = {
			name = ca_native_resume_initial_knights
			alpha = 1
			trigger_when = "[And( And( And( GetPlayer.IsValid, GetPlayer.IsAlive ), And( GetPlayer.IsLocalPlayer, GetPlayer.IsPlayer ) ), GetScriptedGui('ca_resume_initial_knights').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
			on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( And( And( GetPlayer.IsValid, GetPlayer.IsAlive ), And( GetPlayer.IsLocalPlayer, GetPlayer.IsPlayer ) ), GetScriptedGui('ca_resume_initial_knights').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ), 'ca_native_initial_knights_capture', 'ca_native_knights_noop'))]"
		}
		state = {
			name = ca_native_initial_knights_capture
			alpha = 1
			on_start = "[GetVariableSystem.Set('ca_native_knights_owner', UIntToString(GetPlayer.GetID))]"
			on_start = "[PdxGuiWidget.TriggerAnimation('ca_native_initial_knights_settle')]"
		}
		state = {
			name = ca_native_initial_knights_settle
			duration = 0.5
			alpha = 1
			on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( GetVariableSystem.HasValue('ca_native_knights_owner', UIntToString(GetPlayer.GetID)), And( And( And( GetPlayer.IsValid, GetPlayer.IsAlive ), And( GetPlayer.IsLocalPlayer, GetPlayer.IsPlayer ) ), GetScriptedGui('ca_resume_initial_knights').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) ), 'ca_native_resume_initial_knights_action', 'ca_native_knights_noop'))]"
		}
		state = {
			name = ca_native_resume_initial_knights_action
			alpha = 1
			on_start = "[GetScriptedGui('ca_resume_initial_knights').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
	}
	widget = {
		name = ca_native_all_workers
		size = { 1 1 }
		alwaystransparent = yes
		datamodel = "[GetAllCourtPositionTypes]"
		datamodel_reuse_widgets = yes
		item = {
			widget = {
				name = ca_native_position_worker
				size = { 1 1 }
				alwaystransparent = yes
				state = { name = ca_native_noop alpha = 1 }
				state = {
					name = ca_native_capture_none
					alpha = 1
					trigger_when = "[And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( And( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( Not( GetScriptedGui('ca_native_has_saved').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), CourtPositionType.HasAutomationNone(GetPlayer) ) ) )]"
					on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( And( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( Not( GetScriptedGui('ca_native_has_saved').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), CourtPositionType.HasAutomationNone(GetPlayer) ) ) ), 'ca_native_capture_none_action', 'ca_native_noop'))]"
				}
				state = {
					name = ca_native_capture_none_action
					alpha = 1
					on_start = "[GetScriptedGui('ca_native_record_none').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End )]"
				}
				state = {
					name = ca_native_target_none
					alpha = 1
					trigger_when = "[And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( Or( And( Not( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet ), GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), GetScriptedGui('ca_native_type_is_releasing').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( Not( GetVariableSystem.HasValue(Concatenate('ca_native_target_epoch_', CourtPositionType.GetKey), GetVariableSystem.Get('ca_native_job_token')) ), Or( GetScriptedGui('ca_native_saved_none').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ), And( Not( GetScriptedGui('ca_native_has_saved').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( And( GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ), And( GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, Not( GetPlayer.MakeScope.GetVariable('ca_native_preserve_unsaved').IsSet ) ) ), EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)0') ) ) ) ) ) )]"
					on_start = "[GetVariableSystem.Set(Concatenate('ca_native_target_', CourtPositionType.GetKey), '0')]"
					on_start = "[GetVariableSystem.Set(Concatenate('ca_native_target_epoch_', CourtPositionType.GetKey), GetVariableSystem.Get('ca_native_job_token'))]"
				}
				state = {
					name = ca_native_sync_none
					alpha = 1
					trigger_when = "[And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( And( Not( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet ), GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( GetVariableSystem.HasValue(Concatenate('ca_native_done_', CourtPositionType.GetKey), GetVariableSystem.Get('ca_native_job_token')), And( CourtPositionType.HasAutomationNone(GetPlayer), Not( GetScriptedGui('ca_native_saved_none').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ) ) ) ) )]"
					on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( And( Not( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet ), GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( GetVariableSystem.HasValue(Concatenate('ca_native_done_', CourtPositionType.GetKey), GetVariableSystem.Get('ca_native_job_token')), And( CourtPositionType.HasAutomationNone(GetPlayer), Not( GetScriptedGui('ca_native_saved_none').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ) ) ) ) ), 'ca_native_sync_none_action', 'ca_native_noop'))]"
				}
				state = {
					name = ca_native_sync_none_action
					alpha = 1
					on_start = "[GetScriptedGui('ca_native_record_none').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End )]"
				}
				state = {
					name = ca_native_capture_event
					alpha = 1
					trigger_when = "[And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( And( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( Not( GetScriptedGui('ca_native_has_saved').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), CourtPositionType.HasAutomationShowEvent(GetPlayer) ) ) )]"
					on_start = "[PdxGuiWidget.TriggerAnimation(Select_CString(And( And( GetPlayer.IsValid, And( GetVariableSystem.HasValue('ca_native_session', Concatenate(UIntToString(GetPlayer.GetID), Concatenate('_', Concatenate(IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_native_policy_epoch').GetValue)), Concatenate('_', Select_CString(GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, 'on', 'off')))))), GetVariableSystem.Exists('ca_native_session_ready') ) ), And( And( GetPlayer.MakeScope.GetVariable('ca_auto_court_enabled').IsSet, GetScriptedGui('ca_native_type_is_managed').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), And( Not( GetScriptedGui('ca_native_has_saved').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End ) ), CourtPositionType.HasAutomationShowEvent(GetPlayer) ) ) ), 'ca_native_capture_event_action', 'ca_native_noop'))]"
				}
				state = {
					name = ca_native_capture_event_action
					alpha = 1
					on_start = "[GetScriptedGui('ca_native_record_event').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('ca_native_type', CourtPositionType.MakeScope).End )]"
				}
				state = {
