			on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(IsGameViewOpen('court_window'),IsGameViewDataShown('court_window',GetPlayer.GetID)),And(Not(IsLeftWindowOpen),And(Not(IsCenterWindowOpen),Not(IsOverviewWindowOpen)))),'ca_kf_prime_gate','ca_kf_bind_empty_1'))]"
