# PROPOSAL: native filters reset barrier, not yet accepted in the CK3 engine.
# Always loaded; no Court visibility dependency on the warm path.
# All native commands run in zero-duration on_finish actions. Timed states
# only route after a wait; no native command uses on_start.
# Unsafe UI defers without a native call or Auto OFF; no timer polling.
# Once started, binding checks and native commands have fixed bounds.
# Each delayed boundary revalidates owner/epoch/ON/pending/local player.
window = {
	name = ca_knight_filters_controller
	size = { 1 1 }
	alwaystransparent = yes
	visible = "[GetPlayer.IsValid]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_busy')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_seen')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_owner')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_epoch')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_owned_view')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_hide_owned_view')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_prime_sent')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_show_sent')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_reset_sent')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_ack_sent')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_failure_sent')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_close_sent')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_result')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_deferred')]"
	oncreate = "[GetVariableSystem.Clear('ca_kf_upgrade_seen')]"
	widget = {
		name = ca_knight_filters_context
		size = { 1 1 }
		datacontext = "[AccessKnightsView]"
		state = {
			name = ca_kf_noop
			duration = 0
			alpha = 1
		}
		state = {
			name = ca_kf_request
			duration = 0
			alpha = 1
			trigger_when = "[And(And(And(GetPlayer.IsValid,And(GetPlayer.IsAlive,And(GetPlayer.IsLocalPlayer,GetPlayer.IsPlayer))),And(GetPlayer.MakeScope.GetVariable('ca_auto_knights_enabled').IsSet,And(GetPlayer.MakeScope.GetVariable('ca_knight_reset_pending').IsSet,GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').IsSet))),And(And(And(IsDefaultGUIMode,And(Not(IsPausedByEvent),And(Not(IsPauseMenuShown),And(Not(IsFullScreenWindowOpen),And(Not(IsInteractionConfirmationWindowOpen),Not(IsMapInteractionConfirmationWindowOpen)))))),Or(And(KnightsView.GetMilitaryView.GetCharacter.IsValid,EqualTo_uint32(KnightsView.GetMilitaryView.GetCharacter.GetID,GetPlayer.GetID)),Or(And(And(IsGameViewOpen('court_window'),IsGameViewDataShown('court_window',GetPlayer.GetID)),And(Not(IsLeftWindowOpen),And(Not(IsCenterWindowOpen),Not(IsOverviewWindowOpen)))),And(Not(IsRightWindowOpen),And(Not(IsLeftWindowOpen),And(Not(IsCenterWindowOpen),And(Not(IsOverviewWindowOpen),And(Not(IsBottomWindowOpen),And(Not(IsBottomLeftWindowOpen),And(Not(IsGameViewOpen('court_window')),And(Not(IsGameViewOpen('military')),Not(IsGameViewOpen('knights'))))))))))))),And(Not(GetVariableSystem.Exists('ca_kf_busy')),Not(GetVariableSystem.HasValue('ca_kf_seen',Concatenate(UIntToString(GetPlayer.GetID),Concatenate('_',IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').GetValue)))))))))]"
			on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(And(GetPlayer.IsValid,And(GetPlayer.IsAlive,And(GetPlayer.IsLocalPlayer,GetPlayer.IsPlayer))),And(GetPlayer.MakeScope.GetVariable('ca_auto_knights_enabled').IsSet,And(GetPlayer.MakeScope.GetVariable('ca_knight_reset_pending').IsSet,GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').IsSet))),And(And(And(IsDefaultGUIMode,And(Not(IsPausedByEvent),And(Not(IsPauseMenuShown),And(Not(IsFullScreenWindowOpen),And(Not(IsInteractionConfirmationWindowOpen),Not(IsMapInteractionConfirmationWindowOpen)))))),Or(And(KnightsView.GetMilitaryView.GetCharacter.IsValid,EqualTo_uint32(KnightsView.GetMilitaryView.GetCharacter.GetID,GetPlayer.GetID)),Or(And(And(IsGameViewOpen('court_window'),IsGameViewDataShown('court_window',GetPlayer.GetID)),And(Not(IsLeftWindowOpen),And(Not(IsCenterWindowOpen),Not(IsOverviewWindowOpen)))),And(Not(IsRightWindowOpen),And(Not(IsLeftWindowOpen),And(Not(IsCenterWindowOpen),And(Not(IsOverviewWindowOpen),And(Not(IsBottomWindowOpen),And(Not(IsBottomLeftWindowOpen),And(Not(IsGameViewOpen('court_window')),And(Not(IsGameViewOpen('military')),Not(IsGameViewOpen('knights'))))))))))))),And(Not(GetVariableSystem.Exists('ca_kf_busy')),Not(GetVariableSystem.HasValue('ca_kf_seen',Concatenate(UIntToString(GetPlayer.GetID),Concatenate('_',IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').GetValue))))))))),'ca_kf_capture','ca_kf_noop'))]"
		}
		state = {
			name = ca_kf_capture
			duration = 0
			alpha = 1
			on_finish = "[GetVariableSystem.Set('ca_kf_busy','yes')]"
			on_finish = "[GetVariableSystem.Set('ca_kf_seen',Concatenate(UIntToString(GetPlayer.GetID),Concatenate('_',IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').GetValue)))))]"
			on_finish = "[GetVariableSystem.Set('ca_kf_owner',UIntToString(GetPlayer.GetID))]"
			on_finish = "[GetVariableSystem.Set('ca_kf_epoch',IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').GetValue)))]"
			on_finish = "[GetVariableSystem.Set('ca_kf_was_open',Select_CString(IsGameViewOpen('knights'),'yes','no'))]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_owned_view')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_hide_owned_view')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_prime_sent')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_show_sent')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_reset_sent')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_ack_sent')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_failure_sent')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_close_sent')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_result')]"
			on_finish = "[GetVariableSystem.Clear('ca_kf_deferred')]"
			on_finish = "[PdxGuiWidget.TriggerAnimation('ca_kf_settle')]"
		}
		# No work during the initial player-transfer settling interval.
		state = {
			name = ca_kf_settle
			duration = 0.5
			alpha = 1
			on_finish = "[PdxGuiWidget.TriggerAnimation(Select_CString(And(And(And(GetPlayer.IsValid,And(GetPlayer.IsAlive,And(GetPlayer.IsLocalPlayer,GetPlayer.IsPlayer))),And(GetPlayer.MakeScope.GetVariable('ca_auto_knights_enabled').IsSet,And(GetPlayer.MakeScope.GetVariable('ca_knight_reset_pending').IsSet,GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').IsSet))),And(GetVariableSystem.Exists('ca_kf_busy'),And(GetVariableSystem.HasValue('ca_kf_owner',UIntToString(GetPlayer.GetID)),GetVariableSystem.HasValue('ca_kf_epoch',IntToString(FixedPointToInt(GetPlayer.MakeScope.GetVariable('ca_knight_reset_epoch').GetValue)))))),'ca_kf_bind_check_1','ca_kf_cleanup'))]"
		}
