# Court Automation picker, instantiated through scripted_widgets.
# Entry decision: set_variable = { name = ca_automation_window value = 1 }
# Compatibility view only. Native mutation is owned by ca_native_automation.gui;
# closing this window never cancels a saved policy or background maintenance.
window = {
	name = "ca_automation_window"
	parentanchor = center
	size = { 720 740 }
	layer = events
	movable = yes
	allow_outside = yes
	visible = "[And( GetPlayer.IsValid, GetPlayer.MakeScope.GetVariable('ca_automation_window').IsSet )]"
	using = Window_Background
	using = Window_Decoration_Spike

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}

	# Content width: 720 - 40 - 40 = 640. Fixed cells prevent localized text
	# from resizing its neighbors; table content reserves a permanent status slot.
	vbox = {
		using = Window_Margins
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		spacing = 10
		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" { text = "ca_automation_title" }
			blockoverride "button_close" {
				onclick = "[GetScriptedGui('ca_automation_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		text_multi = {
			size = { 640 48 }
			minimumsize = { 640 48 }
			maximumsize = { 640 48 }
			text = "ca_automation_intro"
			layoutpolicy_horizontal = expanding
			fontsize = 16
		}
		hbox = {
			spacing = 10
			layoutpolicy_horizontal = expanding
			button_standard = {
				size = { 315 44 }
				minimumsize = { 315 44 }
				maximumsize = { 315 44 }
				text = "ca_automation_mode_none"
				tooltip = "ca_automation_mode_none_tt"
				down = "[And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)0'))]"
					enabled = "[GetScriptedGui('ca_bulk_policy_none').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui('ca_bulk_policy_none').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			button_standard = {
				size = { 315 44 }
				minimumsize = { 315 44 }
				maximumsize = { 315 44 }
				text = "ca_automation_mode_event"
				tooltip = "ca_automation_mode_event_tt"
				down = "[And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)1'))]"
					enabled = "[GetScriptedGui('ca_bulk_policy_event').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui('ca_bulk_policy_event').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		hbox = {
			spacing = 10
			layoutpolicy_horizontal = expanding
			button_standard = {
				size = { 315 44 }
				minimumsize = { 315 44 }
				maximumsize = { 315 44 }
				text = "ca_automation_mode_best"
				tooltip = "ca_automation_mode_best_tt"
				down = "[And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)2'))]"
					enabled = "[GetScriptedGui('ca_bulk_policy_best').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui('ca_bulk_policy_best').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			button_standard = {
				size = { 315 44 }
				minimumsize = { 315 44 }
				maximumsize = { 315 44 }
				text = "ca_automation_mode_best_event"
				tooltip = "ca_automation_mode_best_event_tt"
				down = "[And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)3'))]"
					enabled = "[GetScriptedGui('ca_bulk_policy_best_event').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
				onclick = "[GetScriptedGui('ca_bulk_policy_best_event').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
		}
		text_multi = {
			size = { 640 48 }
			minimumsize = { 640 48 }
			maximumsize = { 640 48 }
			text = "ca_automation_result_help"
			layoutpolicy_horizontal = expanding
			fontsize = 15
		}
		# Fixed table geometry: 314 + 12 + 230 + 12 + 32 = 600.
		hbox = {
			margin_left = 12
			margin_right = 28
			spacing = 12
			text_single = {
				size = { 314 24 }
				minimumsize = { 314 24 }
				maximumsize = { 314 24 }
				autoresize = no
				align = left|vcenter
				fontsize = 15
				text = "ca_automation_column_position"
				default_format = "#high"
			}
			text_single = {
				size = { 230 24 }
				minimumsize = { 230 24 }
				maximumsize = { 230 24 }
				autoresize = no
				align = left|vcenter
				fontsize = 15
				text = "ca_automation_column_mode"
				default_format = "#high"
			}
			text_single = {
				size = { 32 24 }
				minimumsize = { 32 24 }
				maximumsize = { 32 24 }
				autoresize = no
				align = center
				fontsize = 15
				text = "ca_automation_applied"
				tooltip = "ca_automation_column_status_tt"
			}
		}
		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_margins" {
				margin_left = 12
				margin_right = 28
				margin_top = 8
				margin_bottom = 8
			}
			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2
					datamodel = "[GetAllCourtPositionTypes]"
					item = {
						hbox = {
							size = { 600 34 }
							spacing = 12
							text_single = {
								size = { 314 34 }
								minimumsize = { 314 34 }
								maximumsize = { 314 34 }
								autoresize = no
								align = left|vcenter
								fontsize = 15
								text = "[CourtPositionType.CalcTriggeredNameNoTooltip( GetPlayer )]"
								tooltip = "[CourtPositionType.CalcTriggeredNameNoTooltip( GetPlayer )]"
							}
							text_single = {
								size = { 230 34 }
								minimumsize = { 230 34 }
								maximumsize = { 230 34 }
								autoresize = no
								align = left|vcenter
								fontsize = 15
								text = "[Select_CString( CourtPositionType.HasAutomationNone( GetPlayer ), Localize('ca_automation_mode_none'), Select_CString( CourtPositionType.HasAutomationShowEvent( GetPlayer ), Localize('ca_automation_mode_event'), Select_CString( CourtPositionType.HasAutomationAssignBest( GetPlayer ), Localize('ca_automation_mode_best'), Localize('ca_automation_mode_best_event') ) ) )]"
							}
							# Hiding the indicator never removes its column.
							widget = {
								size = { 32 34 }
								minimumsize = { 32 34 }
								maximumsize = { 32 34 }
								text_single = {
									size = { 32 34 }
									minimumsize = { 32 34 }
									maximumsize = { 32 34 }
									autoresize = no
									align = center
									fontsize = 15
									text = "[Select_CString( Or( And( And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)0')), CourtPositionType.HasAutomationNone( GetPlayer ) ), Or( And( And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)1')), CourtPositionType.HasAutomationShowEvent( GetPlayer ) ), Or( And( And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)2')), CourtPositionType.HasAutomationAssignBest( GetPlayer ) ), And( And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)3')), CourtPositionType.HasAutomationAssignBestOrEvent( GetPlayer ) ) ) ) ), Localize('ca_automation_applied'), Localize('ca_automation_pending') )]"
									visible = "[Or( And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)0')), Or( And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)1')), Or( And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)2')), And(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').IsSet, EqualTo_CFixedPoint(GetPlayer.MakeScope.GetVariable('ca_bulk_automation_policy').GetValue, '(CFixedPoint)3')) ) ) )]"
								}
							}
						}
					}
				}
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			expand = {}
			button_standard = {
				size = { 220 42 }
				text = "ca_automation_close"
				onclick = "[GetScriptedGui('ca_automation_close').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			}
			expand = {}
		}
	}
}

